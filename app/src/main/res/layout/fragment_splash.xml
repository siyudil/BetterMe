<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Top-right decorative shape -->

    <!-- Bottom-left decorative shape -->
    <View
        android:id="@+id/decorTopRight"
        android:layout_width="226dp"
        android:layout_height="235dp"
        android:background="@drawable/splash_shape_top_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/decorBottomLeft"
        android:layout_width="226dp"
        android:layout_height="235dp"
        android:background="@drawable/splash_shape_bottom_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="345dp"
            android:layout_height="203dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/betterme"
            android:src="@drawable/betterme_logo" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetStarted"
        style="@style/Widget.Material3.Button"
        android:layout_width="335dp"
        android:layout_height="71dp"
        android:layout_margin="24dp"
        android:layout_marginBottom="44dp"
        android:backgroundTint="@color/colorPrimary"
        android:insetTop="14dp"
        android:insetBottom="14dp"
        android:text="@string/splash_get_started"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="textEnd"
        app:iconPadding="8dp"
        app:iconSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"
        app:layout_constraintVertical_bias="0.741" />

</androidx.constraintlayout.widget.ConstraintLayout>
