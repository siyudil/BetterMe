<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="6dp">
            <Button
                android:id="@+id/btnToday"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_today"
                android:background="@drawable/bg_tab_inactive"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <Button
                android:id="@+id/btnWeekly"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_weekly"
                android:background="@drawable/bg_tab_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"/>
            <TextView
                android:id="@+id/tvRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/date_range_sample"
                android:layout_weight="1"
                android:gravity="center"
                android:textStyle="bold"/>
            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <!-- Drink Completion Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_drink_completion"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_toggle"/>
            </LinearLayout>
            <com.sliit.betterme.ui.hydration.views.BarChartView
                android:id="@+id/chartCompletion"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Hydrate Line Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_hydrate"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_toggle"/>
            </LinearLayout>
            <com.sliit.betterme.ui.hydration.views.LineChartView
                android:id="@+id/chartHydrate"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Drink Types Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_drink_types"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_toggle"/>
            </LinearLayout>
            <com.sliit.betterme.ui.hydration.views.DonutChartView
                android:id="@+id/chartTypes"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/legendTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
