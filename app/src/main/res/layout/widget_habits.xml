<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_today_habits"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/tvWidgetBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_habits_yet"
        android:textColor="#555555"/>

    <!-- Summary text used by HabitProgressWidgetProvider -->
    <TextView
        android:id="@+id/tvWidgetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_summary_default"
        android:textColor="#000000"/>

    <!-- Determinate progress bar used by HabitProgressWidgetProvider -->
    <ProgressBar
        android:id="@+id/widgetProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"/>

</LinearLayout>
